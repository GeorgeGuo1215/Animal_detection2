# === PetHealthAI Agent 环境变量 ===
# 复制此文件为 .env 并填入实际值
# cp .env.example .env

# ── LLM API（必需，用于 Agent 对话）──
OPENAI_API_KEY=your-api-key-here
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_MODEL=deepseek-v4-flash

# ── Tavily 搜索（可选，用于 MCP 网络搜索工具）──
# TAVILY_API_KEY=your-tavily-key-here

# ── PetMind MySQL（sql.search，只读查询 daily_reports；默认本机 petmind 库）──
# RadarVital 模拟报告默认写入同一个库，Agent 仅通过 sql.search 读取。
PETMIND_MYSQL_HOST=127.0.0.1
PETMIND_MYSQL_PORT=3306
PETMIND_MYSQL_USER=root
PETMIND_MYSQL_PASSWORD=
PETMIND_MYSQL_DATABASE=petmind
# PETMIND_SQL_MAX_LIMIT=200
# AGENT_SQL_DEBUG=0

# ── vitals_alert MCP（心率/呼吸率异常告警，只读 PetHealth 的 PostgreSQL）──
# 连接串格式同 PetHealth_Server 的 DATABASE_URL；docker-compose 生产映射端口为 15432。
# VITALS_DB_DSN=postgresql://postgres:postgres@127.0.0.1:5432/PetHealth
# 表名大小写敏感（Prisma 建表时带双引号），改库表时按实际填写。
# VITALS_METRIC_TABLE=PetHealthMetric
# VITALS_PET_TABLE=Pet
# 阈值默认按物种内置（狗 60-140 / 猫 120-220 / 鸟 200-600 ...），这里只覆盖需要改的部分。
# 指标名 heartRate/heart_rate、breathRate/respiratoryRate 都认。
# VITALS_THRESHOLDS_JSON={"DOG":{"heartRate":{"min":55,"max":150}}}
# 越界样本占比达到该值，告警从 warning 升级为 alert。
# VITALS_ABNORMAL_RATIO=0.2
# VITALS_DB_CONNECT_TIMEOUT=5
# sql.search 需在请求中提供 animal_id（JSON 字段或请求头 X-Animal-Id），否则工具不会对 Agent 暴露

# ── Hugging Face / 本地模型（RAG 预热）──
# 无法访问 huggingface.co 时设为 1；若本机已有 HF Hub 缓存目录（如
# %USERPROFILE%\.cache\huggingface\hub\models--intfloat--multilingual-e5-small），
# 启动时会自动解析 snapshots 子目录，一般无需再配 AGENT_EMBEDDING_MODEL_PATH。
# AGENT_HF_OFFLINE=1
# AGENT_EMBEDDING_MODEL_PATH=C:\path\to\multilingual-e5-small
# AGENT_RERANKER_MODEL_PATH=C:\path\to\bge-reranker-large
# 亦可把模型目录放到 agentAndRag/models/multilingual-e5-small（与上方二选一）
# HF_HOME=...   # 自定义 Hugging Face 缓存根（默认 %USERPROFILE%\.cache\huggingface）

# ── n8n 入站（integration 包，合并于 POST /integration/ingest）──
# N8N_WEBHOOK_URL=http://127.0.0.1:5678/webhook/a3ab4cd2-f1f7-4a49-8c66-0669554731ec
# N8N_TIMEOUT_SEC=60

# ── Agent 服务配置 ──
# Windows/Linux 启动脚本优先使用该解释器；未设置时再检查已知 Conda 环境和 PATH。
# AGENT_PYTHON=C:\path\to\python.exe
AGENT_ENABLE_CORS=1
AGENT_WARMUP_DEVICE=cuda
AGENT_WARMUP_RAG=1
AGENT_WARMUP_BM25=1
AGENT_WARMUP_RERANKER=1
AGENT_WARMUP_CATEGORIES=1
# AGENT_DISABLE_AUTH=0
# AGENT_RATE_LIMIT=30

# ── 用户级跨会话记忆（统一启动脚本会自动启用）──
# PostgreSQL + pgvector 独立库；生产部署前先执行 init_local_db 或迁移脚本。
MEMORY_DB_DSN=postgresql://postgres:postgres@127.0.0.1:5432/petmemory_dev
MEMORY_HOST=127.0.0.1
MEMORY_PORT=8300
# 启动时自动建本地数据库/应用 schema；生产环境建议由部署迁移阶段执行。
# AGENT_MEMORY_INIT_DB=0
# 记忆不可用时是否阻止 Agent 启动与请求。统一启动默认 1。
AGENT_MEMORY_REQUIRED=1
# AGENT_MEMORY_START_TIMEOUT=180
MEMORY_WARMUP_EMBEDDING=1
# MEMORY_WORKERS_ENABLED=1
# AGENT_MEMORY_TIMEOUT=3
# AGENT_MEMORY_MAX_CONTEXT_CHARS=12000

# ── 全局资源并发保护（单进程）──
# AGENT_RESOURCE_LIMITS_ENABLED=1
# AGENT_LLM_MAX_CONCURRENCY=4
# AGENT_RAG_MAX_CONCURRENCY=1
# AGENT_MCP_MAX_CONCURRENCY=4
# AGENT_RESOURCE_ACQUIRE_TIMEOUT_SEC=30

# ── MoE 任务驱动专家（统一策略分配工具，专家单轮归纳）──
# MOE_EXPERT_TIMEOUT_SEC=120
# MOE_EXPERT_FINAL_MAX_TOKENS=1400
# MOE_EXPERT_FORMAT_REPAIR_ATTEMPTS=1
# MOE_EXPERT_FINALIZE_RESERVE_SEC=12
# MOE_RAG_BROKER_TIMEOUT_SEC=120
# RAG_WEB_FALLBACK_MIN_HITS=2
# RAG_RELEVANCE_THRESHOLD=0.55

# ── MoE 终答 token 预算（默认值，同时作为请求 max_tokens 的封顶）──
# MOE_FINAL_ANSWER_MAX_TOKENS=2500

# ── 服务地址 ──
AGENT_HOST=0.0.0.0
AGENT_PORT=8000
