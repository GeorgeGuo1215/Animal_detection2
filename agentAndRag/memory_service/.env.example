# ---------------------------------------------------------------- 数据库
# 生产指向 pet-server 的 PostgreSQL；本地调试用 scripts/init_local_db.py 建的独立库。
# 注意：该库需要 pgvector 扩展，pet-server 现用的 timescale/timescaledb 镜像已自带，
# 只需执行 CREATE EXTENSION vector，无需更换镜像。
MEMORY_DB_DSN=postgresql://postgres:postgres@127.0.0.1:5432/petmemory_dev
MEMORY_DB_CONNECT_TIMEOUT=5
MEMORY_DB_POOL_MIN=1
MEMORY_DB_POOL_MAX=8

# ---------------------------------------------------------------- 向量化
# 与 RAG 子系统同模型同维度（384）。改模型必须同步改 sql/001_schema.sql 里的 vector(384)。
MEMORY_EMBEDDING_MODEL=intfloat/multilingual-e5-small
# 默认 cpu，避免与本机其他项目抢显卡
MEMORY_EMBEDDING_DEVICE=cpu
MEMORY_EMBEDDING_DIM=384

# ---------------------------------------------------------------- LLM
# 未设置时回退到仓库里已有的 OPENAI_BASE_URL / OPENAI_API_KEY / OPENAI_MODEL
# MEMORY_LLM_BASE_URL=https://api.deepseek.com/v1
# MEMORY_LLM_API_KEY=sk-xxx
# MEMORY_LLM_MODEL=deepseek-chat
MEMORY_LLM_TIMEOUT=60

# ---------------------------------------------------------------- 各层容量
# 短期队列超过此长度即触发向中期提升
MEMORY_SHORT_TERM_CAPACITY=10
# 单用户中期话题段上限，超出按热度升序汰换。
# 由 scripts/simulate_usage.py 标定：200 轮对话稳定在 18 段，容量给到 200 等于永不汰换。
MEMORY_MID_TERM_CAPACITY=50
# 单用户长期知识条目上限
MEMORY_KNOWLEDGE_CAPACITY=200

# ---------------------------------------------------------------- 提升节流
# 短期溢出量攒够这么多条才触发一次提升，直接决定摘要 LLM 的调用频率。
# 设成 1 等于每轮对话都调一次 LLM。
MEMORY_PROMOTION_BATCH=5
# 话题段内攒够这么多条未分析对话，才重新做画像与知识抽取。
# 设成 1 表示有新对话就分析。别为了省 LLM 调用调大：话题段做细之后，"去年打疫苗
# 过敏"这类一次性的关键陈述会独占一个 1 页的段，门槛一高就永远凑不满，过敏史因此
# 一条都沉淀不进长期知识（实测门槛设 5 时，全库 37% 的对话从未被分析）。
MEMORY_ANALYSIS_MIN_PAGES=1

# ---------------------------------------------------------------- 热度
# H = alpha*log1p(访问次数) + beta*log1p(页数) + gamma*exp(-Δh/tau)
MEMORY_HEAT_ALPHA=1.0
MEMORY_HEAT_BETA=1.0
MEMORY_HEAT_GAMMA=1.0
MEMORY_HEAT_TAU_HOURS=24
# 超过此热度的话题段会被提升为长期画像与知识
MEMORY_HEAT_THRESHOLD=3.0

# ---------------------------------------------------------------- 话题合并与连续性
# 综合相似度 = 语义余弦 + KEYWORD_WEIGHT * 关键词 Jaccard，超过阈值则并入已有段。
# 1.2 由 scripts/calibrate_similarity.py --real-llm 标定：语料必须是真实模型生成的段
# 摘要，而不是手写对话原文——摘要句式雷同，跨话题余弦 P50 就有 0.96，拿原文标出来的
# 阈值搬过来会让所有话题挤成一个段（实测 18 段塌成 4 段）。
# 换 embedding 模型或改摘要提示词都要重跑标定。
MEMORY_SEGMENT_SIMILARITY_THRESHOLD=1.2
MEMORY_KEYWORD_WEIGHT=1.0
# 连续性启发式：间隔在此分钟数内且语义相似度达标，视为同一话题的延续
MEMORY_CONTINUITY_GAP_MINUTES=30
MEMORY_CONTINUITY_SIMILARITY=0.5

# ---------------------------------------------------------------- 检索
MEMORY_TOP_K_SEGMENTS=5
MEMORY_TOP_K_PAGES=7
MEMORY_TOP_K_KNOWLEDGE=5
MEMORY_SHORT_TERM_CONTEXT_SIZE=6

# ---------------------------------------------------------------- worker
MEMORY_WORKER_CONCURRENCY=2
MEMORY_WORKER_POLL_INTERVAL=1.0
MEMORY_TASK_MAX_ATTEMPTS=3

# ---------------------------------------------------------------- 服务
MEMORY_HOST=0.0.0.0
MEMORY_PORT=8300
