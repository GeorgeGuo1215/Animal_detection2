AGENT_PLATFORM_ENABLED=1
AGENT_PLATFORM_ENV=production
AGENT_PLATFORM_DB_URL=postgresql+asyncpg://petmind:CHANGE_ME@127.0.0.1:15433/petmind_agent
AGENT_PLATFORM_REDIS_URL=redis://127.0.0.1:16379/0
AGENT_PLATFORM_AUTO_CREATE_SCHEMA=0
AGENT_PLATFORM_JWT_SECRET=replace-with-at-least-32-random-bytes
AGENT_PLATFORM_COOKIE_SECURE=1
AGENT_PLATFORM_REFRESH_REUSE_GRACE_SEC=5
AGENT_PLATFORM_EXPOSE_DEV_TOKENS=0
AGENT_PLATFORM_FRONTEND_ORIGIN=https://agent.example.com
AGENT_PLATFORM_ALLOWED_HOSTS=agent-api.example.com,127.0.0.1
AGENT_PLATFORM_PAYMENT_WEBHOOK_SECRET=replace-with-an-independent-webhook-secret
AGENT_PLATFORM_RATE_LIMIT=60
AGENT_PLATFORM_RATE_BURST=20
# Unified HTTP quotas: tokens/minute and maximum accumulated burst.
# AGENT_PLATFORM_RATE_* remain fallback aliases for generation only.
AGENT_HTTP_RATE_PREFIX=petmind:http:v1
AGENT_HTTP_IP_RATE=600
AGENT_HTTP_IP_BURST=120
AGENT_HTTP_AUTH_RATE=60
AGENT_HTTP_AUTH_BURST=20
AGENT_HTTP_READ_RATE=300
AGENT_HTTP_READ_BURST=60
AGENT_HTTP_WRITE_RATE=120
AGENT_HTTP_WRITE_BURST=20
AGENT_HTTP_FEEDBACK_RATE=30
AGENT_HTTP_FEEDBACK_BURST=6
AGENT_HTTP_GENERATION_RATE=60
AGENT_HTTP_GENERATION_BURST=20
AGENT_HTTP_CONTROL_RATE=120
AGENT_HTTP_CONTROL_BURST=20
AGENT_HTTP_LEGACY_RATE=30
AGENT_HTTP_LEGACY_BURST=30
AGENT_PLATFORM_SYNC_TIMEOUT_SEC=120
AGENT_PLATFORM_DB_POOL_SIZE=10
AGENT_PLATFORM_DB_MAX_OVERFLOW=20
AGENT_WORKER_HOST=127.0.0.1
AGENT_WORKER_PORT=8102
AGENT_WORKER_URL=http://127.0.0.1:8102
AGENT_WORKER_TOKEN=replace-with-an-independent-32-byte-random-secret
AGENT_WORKER_CONNECT_TIMEOUT_SEC=5
AGENT_WORKER_READY_TIMEOUT_SEC=2
AGENT_WORKER_MAX_CONNECTIONS=100
AGENT_WORKER_MAX_KEEPALIVE_CONNECTIONS=20
AGENT_SHUTDOWN_TIMEOUT_SEC=10
AGENT_MEMORY_ENABLED=1
AGENT_MEMORY_URL=http://127.0.0.1:8300
MEMORY_MANAGEMENT_TOKEN=replace-with-an-independent-32-byte-random-secret
AGENT_LEGACY_API_KEYS_ENABLED=1
AGENT_TRUST_PROXY_HEADERS=1
AGENT_FORWARDED_ALLOW_IPS=127.0.0.1
